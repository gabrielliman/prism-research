        self.assertEqual(s1.kmin_gb(0, [1000], CELL), 0.0)  # off
        self.assertAlmostEqual(s1.kmin_gb(4, [], CELL), 4 * 1024 * CELL / 2**30)  # empty queue: 1024 tokens
