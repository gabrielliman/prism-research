+"""Trace adaptation (F3.3, PLANO_AGENTE.md section 5.3 protocol): raw public trace -> normalized trace for
+overload_load.py --pattern trace (workloads.py), plus statistics before and after the transformation.
+
+Usage (opt-env Python; datasets under /mnt/scratch/scheduler/datasets/<id>/, never in git):
+  trace_adapt.py azfn   --src invocations_per_function_md.anon.d01.csv --out polyaxon/traces/T3_azfn.csv.gz
+                        [--n 12 --window-min 60 --start-min 600 --target-rate 2.0 --span 600 --lengths <norm trace>]
+  trace_adapt.py window --src AzureLLMInferenceTrace_conv.csv --kind azllm --out polyaxon/traces/T4_azllm.csv.gz
+                        [--n 12 --win 30 --span 600]
+  trace_adapt.py window --src BurstGPT_1.csv --kind burstgpt --out polyaxon/traces/T5_burst.csv.gz
+                        [--n 12 --win 600 --span 600 --filter "ChatGPT/API log"]
+  trace_adapt.py lengths --src AzureLLMInferenceTrace_conv.csv --out polyaxon/traces/L_azllm_conv.csv.gz
+                        (length table for --lengths empirical:<file>: every request's (prompt, output), arrival 0)
+
+Entity rules (section 5.3, items 2-4; decision D28):
+  azfn    T3. Azure Functions 2019 has per-minute invocation counts per function, no tokens. Take the HTTP-triggered
+          functions (user-facing requests) in a --window-min window starting at minute --start-min of the day, rank
+          them by invocations in the window, and keep --n ranks log-spaced over a popularity band whose top/bottom
+          invocation ratio is --skew (default 8, about T1's 23%/2.8%), the band placed so the total is closest to
+          target-rate x span (no thinning: counts, popularity ratios and per-minute shape are the real ones). Each
+          minute is compressed to span / window-min seconds and its invocations are placed uniformly at random in it
+          (the trace has no sub-minute times; seed 0). Lengths: drawn from --lengths (default T4's length table).
+  window  T4/T5. A single-service trace (Azure LLM 2023: one service per file; BurstGPT: one model + log type,
+          --filter) has no per-model split. Entity i = the i-th consecutive --win-second window from an anchor hour:
+          --anchor busiest (the hour with most requests; T4, a one-hour trace) or --anchor target (the first hour
+          whose n x win s block carries --target-rate at the final time scale; T5, 61 days); each window's arrivals are shifted to 0 and stretched by
+          span / win. Every entity keeps a real arrival process, its CV and its real lengths; the popularity is
+          the natural rate variation between windows (ranks by count). Splitting one stream at random instead would
+          thin it and pull its CV toward 1. BurstGPT timestamps are whole seconds: jitter U[0, 1) s (seed 0),
+          failed requests (0 response tokens) dropped.
+Statistics (<out>.stats.json, section 5.3 item 6): per entity, before (original time; azfn: per-minute counts) and
+after (normalized trace): requests, share, CV of inter-arrivals (azfn: CV of the per-minute counts, before and after
+re-binning), plus the checks "CV change <= 10%" and "popularity order preserved". Caps on prompt/output are applied by
+the generator (--max-prompt/--max-output) and reported in summary.json.
+"""
+import argparse
+import hashlib
+import json
+import os
+import sys
+
+import numpy as np
+import pandas as pd
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import workloads as w  # noqa: E402
+
+
+def sha256(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for b in iter(lambda: f.read(1 << 20), b""):
+            h.update(b)
+    return h.hexdigest()
+
+
+def cv(ts):
+    g = np.diff(np.sort(np.asarray(ts, float)))
+    return float(g.std() / g.mean()) if len(g) > 1 and g.mean() > 0 else None
+
+
+def count_cv(c):
+    c = np.asarray(c, float)
+    return float(c.std() / c.mean()) if c.mean() > 0 else None
+
+
+def checks(before, after):
+    order_b = sorted(before, key=lambda e: (-before[e]["requests"], e))
+    order_a = sorted(after, key=lambda e: (-after[e]["requests"], e))
+    dcv = {e: abs(after[e]["cv"] / before[e]["cv"] - 1) for e in before
+           if before[e].get("cv") and after[e].get("cv")}
+    return {"cv_change_max": max(dcv.values()) if dcv else None,
+            "cv_ok": (max(dcv.values()) <= 0.10) if dcv else None,  # None: no arrival times in the source (T2)
+            "popularity_order_ok": order_b == order_a}
+
+
+def finish(a, rows, meta, before, after):
+    rows.sort()
+    meta.update({"source_sha256": sha256(a.src), "source_file": os.path.basename(a.src), "seed": 0,
+                 "requests": len(rows), "span_s": a.span})
+    os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)
+    w.write_trace(a.out, rows, meta)
+    stats = {"meta": meta, "before": before, "after": after, "checks": checks(before, after)}
+    json.dump(stats, open(a.out.replace(".csv.gz", "") + ".stats.json", "w"), indent=1)
+    print(f"{a.out}: {len(rows)} requests, {len(after)} entities, checks {stats['checks']}")
+
+
+def azfn(a):
+    d = pd.read_csv(a.src)
+    d = d[d.Trigger == "http"]
+    cols = [str(m) for m in range(a.start_min + 1, a.start_min + a.window_min + 1)]
+    counts = d[cols].to_numpy()
+    tot = counts.sum(1)
+    order = np.argsort(-tot, kind="stable")
+    target = a.target_rate * a.span
+    st = tot[order]
+
+    def band(r0):  # n ranks log-spaced from r0 to the rank whose count is st[r0] / skew
+        r1 = int(np.searchsorted(-st, -st[r0] / a.skew, side="right")) - 1
+        if r1 - r0 + 1 < a.n:
+            return None
+        return np.unique(np.round(np.geomspace(r0 + 1, r1 + 1, a.n)).astype(int) - 1)
+
+    best = None
+    for r0 in range(len(st)):
+        b = band(r0)
+        if b is None or len(b) < a.n:
+            continue
+        err = abs(st[b].sum() - target)
+        if best is None or err < best[0]:
+            best = (err, r0, b)
+        if st[b].sum() < target:
+            break
+    _, r0, ranks = best
+    sel = order[ranks]
+    tab = w.length_table("empirical:" + a.lengths)
+    rng = np.random.default_rng(0)
+    sec = a.span / a.window_min
+    rows, before, after = [], {}, {}
+    for k, i in enumerate(sel):
+        e = f"fn{k + 1:02d}_{d.HashFunction.iloc[i][:8]}"
+        c = counts[i]
+        ts = np.concatenate([j * sec + rng.random(int(n)) * sec for j, n in enumerate(c)])
+        for t in ts:
+            p, o = tab[rng.integers(len(tab))]
+            rows.append((float(t), e, int(p), int(o)))
+        rebinned = np.bincount((ts // sec).astype(int), minlength=len(c))[:len(c)]
+        before[e] = {"requests": int(c.sum()), "cv": count_cv(c), "cv_kind": "per-minute counts"}
+        after[e] = {"requests": len(ts), "cv": count_cv(rebinned), "cv_kind": "per-minute counts (re-binned)",
+                    "cv_interarrival": cv(ts)}
+    total = sum(v["requests"] for v in after.values())
+    for v in list(before.values()) + list(after.values()):
+        v["share"] = v["requests"] / total
+    meta = {"id": "T3", "source": "Azure Functions 2019 (AzurePublicDataset), day 1, HTTP trigger",
+            "license": "CC-BY-4.0 (cite Shahrad et al., USENIX ATC 2020)",
+            "rule": f"azfn: ranks {[int(r) + 1 for r in ranks]} of {len(order)} HTTP functions by invocations in minutes "
+                    f"{a.start_min}-{a.start_min + a.window_min}; 1 min -> {sec:g} s; uniform within minute; "
+                    f"lengths from {os.path.basename(a.lengths)}",
+            "time_scale": sec / 60}
+    finish(a, rows, meta, before, after)
+
+
+def load_single(a):
+    if a.kind == "azllm":
+        d = pd.read_csv(a.src)
+        t = pd.to_datetime(d.TIMESTAMP)
+        return ((t - t.min()).dt.total_seconds().to_numpy(), d.ContextTokens.to_numpy(), d.GeneratedTokens.to_numpy(),
+                {"id": "T4", "source": f"Azure LLM inference trace 2023 ({os.path.basename(a.src)})",
+                 "license": "CC-BY-4.0 (cite Patel et al., Splitwise, ISCA 2024)"})
+    d = pd.read_csv(a.src)
+    model, log = a.filter.split("/")
+    d = d[(d.Model == model) & (d["Log Type"] == log) & (d["Response tokens"] > 0)]
+    rng = np.random.default_rng(0)
+    t = d.Timestamp.to_numpy(float) + rng.random(len(d))
+    return (t, d["Request tokens"].to_numpy(), d["Response tokens"].to_numpy(),
+            {"id": "T5", "source": f"BurstGPT v1 ({os.path.basename(a.src)}), {a.filter}, failed (0 tokens) dropped, "
+                                   "whole-second timestamps jittered U[0,1) s",
+             "license": "CC-BY-4.0 (cite Wang et al., BurstGPT, 2024)"})
+
+
+def window(a):
+    t, pl, ol, meta = load_single(a)
+    o = np.argsort(t, kind="stable")
+    t, pl, ol = t[o], pl[o], ol[o]
+    hours = np.bincount((t // 3600).astype(int))
+    if a.anchor == "busiest":
+        start = float(np.argmax(hours) * 3600)
+    else:  # first hour whose following n x win s carry the target rate at time scale span / win (closest match)
+        per_s = np.bincount(t.astype(int), minlength=int(t.max()) + 1)
+        blk = int(a.n * a.win)
+        csum = np.concatenate([[0], np.cumsum(per_s)])
+        want = a.target_rate * a.span  # entities run in parallel over span s: target_rate x span requests in all
+        win_s = int(a.win)
+        cand = [(abs(csum[h * 3600 + blk] - csum[h * 3600] - want), h) for h in range(len(hours))
+                if h * 3600 + blk < len(csum)
+                and all(csum[h * 3600 + (k + 1) * win_s] > csum[h * 3600 + k * win_s] for k in range(a.n))]
+        start = float(min(cand)[1] * 3600)
+    scale = a.span / a.win
+    rows, before, after = [], {}, {}
+    for k in range(a.n):
+        lo, hi = start + k * a.win, start + (k + 1) * a.win
+        m = (t >= lo) & (t < hi)
+        e = f"w{k + 1:02d}"
+        ts = (t[m] - lo) * scale
+        rows += [(float(x), e, int(p), int(q)) for x, p, q in zip(ts, pl[m], ol[m])]
+        before[e] = {"requests": int(m.sum()), "cv": cv(t[m])}
+        after[e] = {"requests": len(ts), "cv": cv(ts), "cv_interarrival": cv(ts)}
+    total = sum(v["requests"] for v in after.values())
+    for v in list(before.values()) + list(after.values()):
+        v["share"] = v["requests"] / total
+    meta.update({"rule": f"window: {a.n} consecutive {a.win:g}-s windows from t={start:.0f} s ({a.anchor} anchor), "
+                         f"each stretched x{scale:g} to {a.span:g} s", "time_scale": scale})
+    finish(a, rows, meta, before, after)
+
+
+def lmsys(a):
+    """T2: LMSYS-Chat-1M. Real popularity among the --n most frequent models; synthetic arrivals (the dataset has no
+    times): each entity's count = round(share x target-rate x span) (shares within the top n, so the popularity is
+    exactly the real one), placed as a Poisson process conditioned on that count (uniform order statistics, seed 0);
+    lengths from the entity's own conversations: first user turn (prompt) and first assistant turn (output),
+    tokenized with --tokenizer, from a seeded sample of up to --pool conversations per entity (empty answers dropped).
+    The output is NOT redistributable (LMSYS-Chat-1M license): keep it out of the repository (.gitignore)."""
+    import glob
+    sys.path.insert(0, a.pqlib) if a.pqlib else None
+    import pyarrow.parquet as pq
+    from transformers import AutoTokenizer
+
+    files = sorted(glob.glob(os.path.join(a.src, "*.parquet")))
+    counts = {}
+    for f in files:
+        for m in pq.read_table(f, columns=["model"]).column("model").to_pylist():
+            counts[m] = counts.get(m, 0) + 1
+    top = sorted(counts, key=lambda m: (-counts[m], m))[:a.n]
+    tot_top = sum(counts[m] for m in top)
+    rng = np.random.default_rng(0)
+    pools = {m: [] for m in top}
+    for f in files:
+        t = pq.read_table(f, columns=["model", "conversation"]).to_pylist()
+        for r in t:
+            if r["model"] in pools:
+                c = r["conversation"]
+                if len(c) >= 2 and c[0]["role"] == "user" and c[1]["role"] == "assistant" and c[1]["content"].strip():
+                    pools[r["model"]].append((c[0]["content"], c[1]["content"]))
+    tok = AutoTokenizer.from_pretrained(a.tokenizer)
+    lens = {}
+    for m in top:
+        pool = pools[m]
+        idx = rng.choice(len(pool), size=min(a.pool, len(pool)), replace=False)
+        ps = tok([pool[i][0] for i in idx], add_special_tokens=False)["input_ids"]
+        os_ = tok([pool[i][1] for i in idx], add_special_tokens=False)["input_ids"]
+        lens[m] = [(len(p), len(o)) for p, o in zip(ps, os_)]
+    target = a.target_rate * a.span
+    rows, before, after = [], {}, {}
+    for k, m in enumerate(top):
+        e = f"m{k + 1:02d}_{m}"
+        n = int(round(counts[m] / tot_top * target))
+        ts = np.sort(rng.random(n) * a.span)
+        for t in ts:
+            p, o = lens[m][rng.integers(len(lens[m]))]
+            rows.append((float(t), e, max(1, p), max(1, o)))
+        before[e] = {"requests": counts[m], "share": counts[m] / tot_top, "cv": None,
+                     "prompt_p50": float(np.median([x[0] for x in lens[m]])),
+                     "output_p50": float(np.median([x[1] for x in lens[m]]))}
+        after[e] = {"requests": n, "share": n / max(1, round(target)), "cv": None, "cv_interarrival": cv(ts)}
+    meta = {"id": "T2", "source": "LMSYS-Chat-1M (lmsys/lmsys-chat-1m, 6 parquet files)",
+            "license": "LMSYS-Chat-1M Dataset License Agreement: NO redistribution; keep out of the repository",
+            "rule": f"lmsys: top {a.n} of {len(counts)} models by conversations; counts = real share x "
+                    f"{a.target_rate:g} req/s x {a.span:g} s; Poisson arrivals (synthetic); first-turn lengths, "
+                    f"tokenizer {a.tokenizer}, pool {a.pool} conversations per model", "time_scale": 1}
+    a.src = files[0]  # finish() hashes one file; the others are listed by name in the metadata
+    meta["files"] = " ".join(os.path.basename(f) for f in files)
+    finish(a, rows, meta, before, after)
+
+
+def lengths(a):
+    d = pd.read_csv(a.src)
+    rows = [(0.0, "all", int(p), int(o)) for p, o in zip(d.ContextTokens, d.GeneratedTokens)]
+    w.write_trace(a.out, rows, {"id": "L_azllm_conv", "source": os.path.basename(a.src), "source_sha256": sha256(a.src),
+                                "license": "CC-BY-4.0 (cite Patel et al., Splitwise, ISCA 2024)",
+                                "use": "length table for --lengths empirical:<file> (arrival unused)"})
+    print(f"{a.out}: {len(rows)} (prompt, output) pairs")
+
+
+def main():
+    p = argparse.ArgumentParser()
+    sub = p.add_subparsers(dest="cmd", required=True)
+    f = sub.add_parser("azfn")
+    f.add_argument("--n", type=int, default=12)
+    f.add_argument("--window-min", type=int, default=60)
+    f.add_argument("--start-min", type=int, default=600)
+    f.add_argument("--target-rate", type=float, default=2.0)
+    f.add_argument("--skew", type=float, default=8.0)
+    f.add_argument("--lengths", default=os.path.join(os.path.dirname(__file__), "traces", "L_azllm_conv.csv.gz"))
+    g = sub.add_parser("window")
+    g.add_argument("--kind", choices=["azllm", "burstgpt"], required=True)
+    g.add_argument("--n", type=int, default=12)
+    g.add_argument("--win", type=float, default=30)
+    g.add_argument("--filter", default="ChatGPT/API log")
+    g.add_argument("--anchor", choices=["busiest", "target"], default="busiest")
+    g.add_argument("--target-rate", type=float, default=2.0)
+    sub.add_parser("lengths")
+    h = sub.add_parser("lmsys")
+    h.add_argument("--n", type=int, default=12)
+    h.add_argument("--target-rate", type=float, default=2.0)
+    h.add_argument("--pool", type=int, default=5000)
+    h.add_argument("--tokenizer", default="meta-llama/Llama-3.1-8B-Instruct")
+    h.add_argument("--pqlib", default="", help="extra sys.path entry holding pyarrow (no env change)")
+    for s in (f, g, h, sub.choices["lengths"]):
+        s.add_argument("--src", required=True)
+        s.add_argument("--out", required=True)
+        s.add_argument("--span", type=float, default=600)
+    a = p.parse_args()
+    {"azfn": azfn, "window": window, "lengths": lengths, "lmsys": lmsys}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/polyaxon/workload_check.py b/polyaxon/workload_check.py
new file mode 100644
index 0000000..726a0ca
--- /dev/null
+++ b/polyaxon/workload_check.py
@@ -0,0 +1,176 @@
+"""Check a level's workload against its specification (F3 acceptance: rates ±5%, CV ±10%, popularity preserved).
+
+Usage: /mnt/scratch/scheduler/opt-env/bin/python polyaxon/workload_check.py <level dir> [...] [--seeds 20] [--json]
+
+The specification comes from the level's own summary.json "args" (overload_load.py or workloads.py emit), so the
+same check runs on a local emit and on a dry-run level from the cluster. Two readings per statistic:
+  realized  the requests of this level (one seed): what the run actually sent
+  process   the mean over --seeds seeds of the same arguments: what the generator promises (a single 600-s level
+            of a bursty process cannot be within ±5% of its mean rate: its count's SD is ~CV x sqrt(N))
+Statistics by pattern:
+  all       total rate vs target (per-model rate x models, total rate, or the trace's count / span)
+  constant  per-model CV (median) vs --cv; shares vs uniform (or --model-rates)
+  bursty    per-model CV (median) vs the IPP formula (workloads.ipp_cv)
+  zipf_drift  share of each rank in each drift period, pooled, vs Zipf(alpha); total rate
+  diurnal   mean rate and the peak/trough ratio of 1/10-period bins vs (1 + A) / (1 - A); fixed Zipf shares
+  trace     same requests as the trace (count per entity), popularity order of the entities kept
+  classes   batch fraction vs --batch-frac (absolute ±0.02)
+"""
+import argparse
+import json
+import os
+import statistics
+import sys
+
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import workloads as w  # noqa: E402
+
+TOL_RATE, TOL_CV, TOL_FRAC = 0.05, 0.10, 0.02
+
+
+def ns(args):
+    a = argparse.Namespace(**args)
+    for k, v in vars(build_defaults()).items():
+        if not hasattr(a, k):
+            setattr(a, k, v)
+    return a
+
+
+def build_defaults():
+    p = argparse.ArgumentParser()
+    w.add_args(p)
+    a = p.parse_args(["--models", "m"])
+    a.time_scale = 1.0
+    return a
+
+
+def cv(ts):
+    g = np.diff(np.sort(ts))
+    return float(g.std() / g.mean()) if len(g) > 2 and g.mean() > 0 else None
+
+
+def stats(a, reqs):
+    """reqs: [(t, model, pl, ol, cls)] -> dict of statistics, with the spec targets."""
+    T = a.duration
+    t = np.array([r[0] for r in reqs])
+    per = {m: np.array([r[0] for r in reqs if r[1] == m]) for m in a.models}
+    out = {"requests": len(reqs), "rate_total": len(reqs) / T}
+    if a.pattern == "constant":
+        rates = dict((kv.split("=")[0], float(kv.split("=")[1])) for kv in a.model_rates)
+        out["target_rate_total"] = sum(rates.get(m, a.rate) for m in a.models) / (a.groups or 1)
+        out["target_cv"] = a.cv if a.groups == 1 else None
+    elif a.pattern == "bursty":
+        out["target_rate_total"] = a.rate * len(a.models)
+        out["target_cv"] = w.ipp_cv(a.rate, a.burst_on, a.burst_off)
+    elif a.pattern in ("zipf_drift", "diurnal"):
+        out["target_rate_total"] = a.total_rate
+        out["target_cv"] = a.cv if a.pattern == "zipf_drift" else None
+    if out.get("target_cv"):
+        cvs = [c for c in (cv(x) for x in per.values()) if c]
+        out["cv_median"] = statistics.median(cvs) if cvs else None
+    if a.pattern == "zipf_drift":
+        orders = w.drift_orders(len(a.models), a.drift_period, T)
+        cnt = np.zeros(len(a.models))
+        for k, o in enumerate(orders):
+            for rank, i in enumerate(o):
+                x = per[a.models[i]]
+                cnt[rank] += ((x >= k * a.drift_period) & (x < (k + 1) * a.drift_period)).sum()
+        out["rank_shares"] = list(cnt / cnt.sum())
+        out["target_rank_shares"] = list(w.zipf_shares(len(a.models), a.zipf_alpha))
+    if a.pattern == "diurnal":
+        P = a.diurnal_period
+        ph = (t % P) / P
+        trough = ((ph < 0.05) | (ph >= 0.95)).sum()
+        peak = ((ph >= 0.45) & (ph < 0.55)).sum()
+        out["peak_trough"] = peak / max(trough, 1)
+        # mean of 1 - A cos over the +-5% bins, peak / trough
+        x = np.linspace(-0.05, 0.05, 201)
+        out["target_peak_trough"] = float(np.mean(1 + a.diurnal_amp * np.cos(2 * np.pi * x)) /
+                                          np.mean(1 - a.diurnal_amp * np.cos(2 * np.pi * x)))
+    if a.pattern == "trace":
+        _, rows = w.read_trace(a.trace)
+        top = w.entity_ranks(rows)[:len(a.models)]
+        want = [sum(r[1] == e for r in rows if r[0] * a.time_scale < T or True) for e in top]
+        got = [len(per[m]) for m in a.models]
+        out["trace_counts_match"] = want == got
+        out["popularity_order_ok"] = got == sorted(got, reverse=True)
+        out["target_rate_total"] = sum(want) / T
+    if a.batch_frac:
+        out["batch_frac"] = sum(r[4] == "batch" for r in reqs) / len(reqs)
+        out["target_batch_frac"] = a.batch_frac
+    return out
+
+
+def verdict(s):
+    v = {}
+    if s.get("target_rate_total"):
+        v["rate"] = abs(s["rate_total"] / s["target_rate_total"] - 1) <= TOL_RATE
+    if s.get("target_cv") and s.get("cv_median"):
+        v["cv"] = abs(s["cv_median"] / s["target_cv"] - 1) <= TOL_CV
+    if "rank_shares" in s:
+        v["popularity"] = list(np.argsort(-np.array(s["rank_shares"]), kind="stable")) == list(range(len(s["rank_shares"])))
+    if "peak_trough" in s:
+        v["diurnal_swing"] = abs(s["peak_trough"] / s["target_peak_trough"] - 1) <= TOL_CV
+    if "trace_counts_match" in s:
+        v["trace"] = s["trace_counts_match"] and s["popularity_order_ok"]
+    if "batch_frac" in s:
+        v["classes"] = abs(s["batch_frac"] - s["target_batch_frac"]) <= TOL_FRAC
+    return v
+
+
+def check(level, seeds):
+    summ = json.load(open(os.path.join(level, "summary.json")))
+    a = ns(summ["args"])
+    rows = json.load(open(os.path.join(level, "requests.json")))
+    reqs = [(r["arrival"], r.get("workload_model", r["model"]), r["prompt_len"], r["output_len"],
+             r.get("slo_class", "interactive")) for r in rows]
+    if a.pattern == "trace":
+        a.duration = summ["args"]["duration"]
+    real = stats(a, reqs)
+    proc = []
+    if a.pattern not in ("trace",):
+        for sd in range(seeds):
+            b = ns(dict(vars(a), seed=1000 + sd))
+            proc.append(stats(b, w.build(b)[0]))
+    mean = {}
+    for k in proc[0] if proc else []:
+        vals = [p[k] for p in proc]
+        if all(isinstance(x, (int, float)) and x is not None for x in vals):
+            mean[k] = float(np.mean(vals))
+        elif all(isinstance(x, list) for x in vals):
+            mean[k] = list(np.mean(np.array(vals), axis=0))
+        else:
+            mean[k] = vals[0]
+    return {"level": level, "pattern": a.pattern, "realized": real, "realized_ok": verdict(real),
+            "process": mean, "process_ok": verdict(mean) if mean else {}}
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("levels", nargs="+")
+    p.add_argument("--seeds", type=int, default=20)
+    p.add_argument("--json", action="store_true")
+    a = p.parse_args()
+    res = [check(d, a.seeds) for d in a.levels]
+    if a.json:
+        print(json.dumps(res, indent=1, default=float))
+        return
+    for r in res:
+        R, P = r["realized"], r["process"]
+        f = lambda x: "-" if x is None else (f"{x:.3f}" if isinstance(x, float) else str(x))
+        print(f"{r['level']} [{r['pattern']}]")
+        print(f"  realized: rate {f(R['rate_total'])} / target {f(R.get('target_rate_total'))}, "
+              f"cv {f(R.get('cv_median'))} / {f(R.get('target_cv'))}"
+              + (f", peak/trough {f(R['peak_trough'])} / {f(R['target_peak_trough'])}" if 'peak_trough' in R else "")
+              + (f", batch {f(R['batch_frac'])}" if 'batch_frac' in R else "") + f"  -> {r['realized_ok']}")
+        if P:
+            print(f"  process : rate {f(P['rate_total'])}, cv {f(P.get('cv_median'))}"
+                  + (f", peak/trough {f(P['peak_trough'])}" if 'peak_trough' in P else "")
+                  + (f", rank shares {[round(x, 3) for x in P['rank_shares']]}" if 'rank_shares' in P else "")
+                  + f"  -> {r['process_ok']}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/workloads/test_workloads.py b/tests/workloads/test_workloads.py
new file mode 100644
index 0000000..3f758e6
--- /dev/null
+++ b/tests/workloads/test_workloads.py
@@ -0,0 +1,147 @@
+"""F3.1/F3.2-F3.5: the workload generators produce what their specification says (polyaxon/workloads.py).
+
+Long horizons, so the checks are on the process, not on the sampling noise of one short level (the realized
+statistics of each catalogue level are in reports/registro/cargas.md). CPU only:
+  /mnt/scratch/scheduler/opt-env/bin/python -m unittest tests/workloads/test_workloads.py
+"""
+import argparse
+import os
+import statistics
+import sys
+import tempfile
+import unittest
+
+import numpy as np
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "..", "polyaxon"))
+import workloads as w  # noqa: E402
+
+
+def args(**kw):
+    p = argparse.ArgumentParser()
+    w.add_args(p)
+    a = p.parse_args(["--models", *[f"model_{i}" for i in range(1, kw.pop("n", 10) + 1)]])
+    a.time_scale = 1.0
+    for k, v in kw.items():
+        setattr(a, k, v)
+    return a
+
+
+def gaps_cv(ts):
+    g = np.diff(np.sort(ts))
+    return g.std() / g.mean()
+
+
+class Processes(unittest.TestCase):
+    def test_renewal_constant_rate_and_cv(self):
+        rng = np.random.default_rng(1)
+        for cv in (1.0, 2.0):
+            ts = w.renewal_on_intensity(rng, *w.cumulative(lambda t: np.full_like(t, 0.5), 40000), cv)
+            self.assertAlmostEqual(len(ts) / 40000, 0.5, delta=0.5 * 0.03)
+            self.assertAlmostEqual(gaps_cv(ts), cv, delta=cv * 0.05)
+
+    def test_ipp_rate_and_cv_formula(self):
+        rng = np.random.default_rng(2)
+        rate, on, off = 0.2, 20.0, 40.0
+        ts = w.ipp_times(rng, rate, on, off, 400000)
+        self.assertAlmostEqual(len(ts) / 400000, rate, delta=rate * 0.03)
+        self.assertAlmostEqual(gaps_cv(ts), w.ipp_cv(rate, on, off), delta=w.ipp_cv(rate, on, off) * 0.05)
+        self.assertTrue(2 <= w.ipp_cv(rate, on, off) <= 4)  # C7 default inside the plan's CV 2-4
+
+    def test_zipf_shares(self):
+        s = w.zipf_shares(4, 1.0)
+        self.assertAlmostEqual(s.sum(), 1)
+        self.assertAlmostEqual(s[0] / s[1], 2)
+        np.testing.assert_allclose(w.zipf_shares(3, 0.0), [1 / 3] * 3)
+
+    def test_drift_rotation(self):
+        o = w.drift_orders(4, 10, 40)
+        self.assertEqual(o[0], [0, 1, 2, 3])
+        self.assertEqual(o[1], [1, 0, 2, 3])
+        self.assertEqual(o[3], [1, 2, 3, 0])  # after n-1 swaps the top model is last, the others rose one rank
+        for a, b in zip(o, o[1:]):  # one adjacent swap per period: gradual
+            self.assertEqual(sum(x != y for x, y in zip(a, b)), 2)
+
+
+class Patterns(unittest.TestCase):
+    def test_zipf_drift_total_rate_and_rotation(self):
+        a = args(n=6, pattern="zipf_drift", total_rate=2.0, duration=50 * 300, drift_period=300, zipf_alpha=1.0)
+        reqs, _ = w.build(a)
+        self.assertAlmostEqual(len(reqs) / a.duration, 2.0, delta=2.0 * 0.03)
+        first = [r for r in reqs if r[0] < 300]
+        top = max(set(r[1] for r in first), key=lambda m: sum(r[1] == m for r in first))
+        self.assertEqual(top, "model_1")  # rank 1 at the start
+        p5 = [r for r in reqs if 5 * 300 <= r[0] < 6 * 300]  # after 5 = n-1 swaps model_1 is last
+        cnt = {m: sum(r[1] == m for r in p5) for m in a.models}
+        self.assertEqual(min(cnt, key=cnt.get), "model_1")
+
+    def test_diurnal_mean_and_swing(self):
+        a = args(n=4, pattern="diurnal", total_rate=2.0, duration=20 * 1200, diurnal_amp=0.8, diurnal_period=1200,
+                 zipf_alpha=0.0)
+        reqs, _ = w.build(a)
+        t = np.array([r[0] for r in reqs])
+        self.assertAlmostEqual(len(t) / a.duration, 2.0, delta=0.06)
+        phase = t % 1200
+        trough = ((phase < 100) | (phase > 1100)).sum() / 200
+        peak = ((phase > 500) & (phase < 700)).sum() / 200
+        self.assertGreater(peak / trough, 5)  # (1+A)/(1-A) = 9 at the extremes, averaged over +-100 s
+
+    def test_bursty_target_cv_in_info(self):
+        a = args(n=3, pattern="bursty", rate=0.2, duration=100000, burst_on=20, burst_off=40)
+        reqs, info = w.build(a)
+        self.assertAlmostEqual(info["target_cv"], w.ipp_cv(0.2, 20, 40))
+        cvs = [gaps_cv([r[0] for r in reqs if r[1] == m]) for m in a.models]
+        self.assertAlmostEqual(statistics.median(cvs), info["target_cv"], delta=info["target_cv"] * 0.1)
+
+    def test_classes_do_not_move_arrivals(self):
+        a0 = args(n=5, pattern="zipf_drift", total_rate=1.0, duration=600)
+        a1 = args(n=5, pattern="zipf_drift", total_rate=1.0, duration=600, batch_frac=0.3)
+        r0, _ = w.build(a0)
+        r1, _ = w.build(a1)
+        self.assertEqual([r[:4] for r in r0], [r[:4] for r in r1])
+        a2 = args(n=5, pattern="zipf_drift", total_rate=1.0, duration=60000, batch_frac=0.3)
+        r2, _ = w.build(a2)
+        self.assertAlmostEqual(sum(r[4] == "batch" for r in r2) / len(r2), 0.3, delta=0.01)
+
+    def test_same_seed_same_workload(self):
+        a = args(n=4, pattern="bursty", rate=0.3, duration=600)
+        self.assertEqual(w.build(a)[0], w.build(args(n=4, pattern="bursty", rate=0.3, duration=600))[0])
+        self.assertNotEqual(w.build(a)[0], w.build(args(n=4, pattern="bursty", rate=0.3, duration=600, seed=7))[0])
+
+
+class Traces(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.mkdtemp()
+        rng = np.random.default_rng(3)
+        rows = []
+        for e, rate in (("a", 1.0), ("b", 0.5), ("c", 0.25), ("d", 0.1)):
+            for t in w.renewal_on_intensity(rng, *w.cumulative(lambda x, r=rate: np.full_like(x, r), 2000), 2.0):
+                rows.append((t, e, int(rng.integers(10, 5000)), int(rng.integers(1, 3000))))
+        rows.sort()
+        self.path = os.path.join(self.dir, "t.csv.gz")
+        w.write_trace(self.path, rows, {"source": "test"})
+        self.rows = rows
+
+    def test_rank_mapping_scale_and_cap(self):
+        a = args(n=3, pattern="trace", trace=self.path, time_scale=0.5, max_prompt=4096, max_output=2048)
+        reqs, info = w.build(a)
+        self.assertEqual({r[1] for r in reqs}, {"model_1", "model_2", "model_3"})  # entity d (least) left out
+        n1 = sum(r[1] == "model_1" for r in reqs)
+        self.assertEqual(n1, sum(r[1] == "a" for r in self.rows))  # most frequent entity -> model_1
+        self.assertAlmostEqual(a.duration, max(r[0] for r in self.rows) * 0.5, places=2)  # trace stores ms
+        self.assertLessEqual(max(r[2] for r in reqs), 4096)
+        self.assertGreater(info["capped_frac"]["prompt"], 0)
+        # time scaling keeps the CV of each entity (section 5.3, item 6)
+        before = gaps_cv([r[0] for r in self.rows if r[1] == "a"])
+        after = gaps_cv([r[0] for r in reqs if r[1] == "model_1"])
+        self.assertAlmostEqual(before, after, places=2)
+
+    def test_empirical_lengths_drawn_from_table(self):
